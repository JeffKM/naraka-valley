extends Node
class_name Onboarding
# T4.1 — 온보딩 흐름 단계 머신(도착 → 옥자 통보 → 미호 멘토 → 튜토리얼 → 첫 수확).
#
# 목적: "신규 시작 시 도착부터 첫 수확까지 안내가 끊김 없이 이어진다"를 회색 UI만으로
#       검증한다(ADR-0001 그레이박스, CONTEXT '온보딩').
#
# 설계 메모:
#   - affinity.gd·energy.gd와 같은 결: 이 노드는 "지금 온보딩 어느 단계인가"라는
#     단일 책임만 가진다. 옥자 컷신 트리거·미호 대화·밭 동작·안내 배너 표시는
#     main이 맡고, 여기서는 단계 상태와 changed 시그널·안내 문구만 제공한다.
#   - 단계는 밭의 자연 순서(괭이질 → 심기 → 물주기 → 성장 → 수확, field 동사 사전조건)에
#     자연히 매핑된다. 그래서 각 사건(on_X)은 "지금 그 단계일 때만" 다음으로 넘기면
#     되고(순서·멱등 안전 — 같은 동작을 두 번 해도, 다른 칸을 먼저 갈아도 흔들리지
#     않는다), 플레이어 행동을 막지 않고 안내만 따라간다("끊김 없이 이어진다").
#   - 서사 텍스트(옥자 통보 대사)는 캐릭터(okja.gd)가 든다(ADR-0005). 여기의 안내
#     문구는 서사가 아니라 조작 가이드라 단계 머신이 들고 있어도 경계를 어기지 않는다.
#   - T2.5 세이브/로드 — 단계 하나(정수)만 직렬화한다. 보존하므로 튜토리얼이 재생되지
#     않고(완료 후), 중도에 끄면 그 단계부터 재개된다. 복원 시 [NOTICE, DONE]로 자른다.

signal changed(step: int)  # 단계가 바뀐 프레임(미래 훅; 현재 main은 _process로 폴링)

# 단계(밭 강제 순서에 매핑). 익명 enum이라 Onboarding.NOTICE처럼 클래스 상수로 쓴다.
enum { NOTICE, MEET_MIHO, TILL, PLANT, WATER, GROW, HARVEST, DONE }

var step: int = NOTICE

# ── 조회 ──────────────────────────────────────────────────────────────────
# 온보딩이 아직 진행 중인가(DONE 전). main이 배너 표시·옥자 컷신 판정에 쓴다.
func is_active() -> bool:
	return step < DONE

# 지금이 옥자 통보(오프닝 컷신) 단계인가. main이 신규 시작·NOTICE 복원 시 자동으로
# 옥자 대화를 띄울지 판정한다(CONTEXT '온보딩': 옥자는 오프닝에 잠깐 등장).
func is_intro() -> bool:
	return step == NOTICE

# 현재 단계의 안내 배너 문구("" = 배너 숨김). NOTICE는 옥자 대화가 화면을 채우고,
# DONE은 온보딩이 끝나 배너가 사라진다. 그 사이 단계만 조작 가이드를 보여준다.
# ★[폴리시 R11] MEET_MIHO만 **미호가 지금 어디 있는지**를 받는다(miho_away = 안식 농원 밖 스테이션).
#   미호는 유일하게 구역을 넘어 출퇴근하는 주민이라(카페 영업 시작 = 15:00 이후엔 나루 마을 카페),
#   시각을 안 보는 옛 한 줄은 하루의 절반 동안 **빈 밭**을 가리켰다 — 그 시간엔 밭 칸에 아무것도
#   안 그려지고 대화 판정도 구역 불일치로 죽으므로, 배너를 따라간 신규 플레이어가 아무 반응 없는
#   흙 앞에 선다(R6가 GROW 줄에서 고친 "거짓 안내"와 같은 종류 — 이쪽은 좌표가 아니라 시각이다).
#   판정은 main이 스케줄에서 파생해 넘긴다(여기서 시계·카페 영업시간을 알 이유가 없다).
func guidance(miho_away: bool = false) -> String:
	match step:
		MEET_MIHO:
			# ★[폴리시 R15] **이동 키를 여기서 한 번 말한다.** 이 단계는 배너 중 유일하게 "어딘가로
			#   가라"고 지시하는데, 게임 전체에서 이동 키를 알려 주는 문자열은 좌상단 readout 한 줄뿐이고
			#   그것은 바로 다음 줄에서 `visible = false`가 되어 **한 번도 화면에 안 뜬다**. 즉 배너가
			#   목적지만 주고 가는 법은 침묵했다(#19의 "자리를 비우고 다시"가 방법 없이 지시만 하던 것과
			#   같은 종류). 첫 단계에만 붙인다 — 뒤 단계는 이미 걸을 줄 아는 플레이어가 본다.
			#   ⚠️ 표기는 **방향키**다. 월드 이동은 `Input.get_vector("ui_*")`이고 project.godot에
			#     `[input]` 섹션이 없어 그 넷은 Godot 기본값(방향키·게임패드)만 든다 — WASD는 안 묶여
			#     있다(타이틀 화면만 WASD를 함께 받는다). 그 비대칭을 없앨지는 조작 체계 결정이라
			#     owner 몫이고, 여기서는 **지금 실제로 먹는 키만** 말한다(광고는 언제나 참이어야 한다).
			if miho_away:
				# ★[폴리시 R16 #2] R15가 이동 키를 얹으며 이 한 줄이 판 폭 675px이 됐다(FONT_SIZE 13 실측
				#   + PAD_X 12×2). 배너 판은 `(view.x − w) * 0.5`로 가운데를 잡는데 view.x = 640이라
				#   좌우로 17.5px씩 화면 밖으로 나가 「▶」와 끝 글자가 잘렸다 — 나머지 전 단계(427~550)와
				#   같은 단계의 집 갈래(463)는 다 들어가고 이 줄만 넘쳤다. 목적지·방향·두 키를 다 남긴 채
				#   군말만 줄여 596px로 앉힌다(polish_r16 ③이 전 단계·양 갈래를 레지스트리 파생으로 잰다).
				return "▶ 미호는 나루 마을 카페에 있다 — [방향키]로 동쪽 길을 따라가 [우클릭]으로 말을 걸어라"
			return "▶ [방향키]로 밭(위쪽)으로 올라가 미호에게 [우클릭]으로 말을 걸어라"
		TILL:
			return "▶ 핫바에서 괭이를 들고(숫자키·휠) 밭 흙에 커서를 두고 [좌클릭]으로 괭이질하라"
		PLANT:
			return "▶ 핫바에서 혼령초 씨앗을 들고 경작한 칸에 [좌클릭]으로 심어라"
		WATER:
			return "▶ 핫바에서 물뿌리개를 들고 심은 칸에 [좌클릭]으로 물을 주어라"
		GROW:
			# ★[폴리시 R6] "집(왼쪽)" → "집(위쪽)". ADR-0035 Phase B 재배치 이후 본가 문
			#   (HOUSE_EXT_DOOR = 44,9)은 스타터 밭(STARTER_PATCH_RECT = x40..44, y12..16) 바로
			#   **북쪽**이다 — 왼쪽에 있는 건 창고(x28..33)와 넋우릿간이라, 옛 문구를 따라가면
			#   잠들 수 없는 건물 앞에서 막힌다. 바로 위 MEET_MIHO 줄("밭(위쪽)")만 재배치에
			#   맞춰 갱신돼 있었다.
			return "▶ 집(위쪽) 문으로 들어가 [우클릭]으로 잠들어 작물을 키워라 (마르면 다시 물 주기)"
		HARVEST:
			# ★[폴리시 R15] "(황금)"을 걷는다 — 성숙 칸을 황금으로 칠하는 코드가 저장소에 없다.
			#   그레이박스 성장단계 점이 걷히면서(main.gd `_build_overlay_tileset` 주석 "시각은 흙
			#   톤만 — 점 제거") 시각 단서는 작물 스프라이트뿐이고, 신규 플레이어가 유일하게 기르는
			#   혼령초의 성숙 프레임은 청록이다. 없는 색을 기다리다 수확을 미루게 하는 대신, 실제로
			#   화면에 뜨는 단서(`_farm_prompt`의 "[우클릭] 수확")를 가리킨다.
			return "▶ 다 자란 작물에 커서를 두면 「[우클릭] 수확」이 뜬다 — 맨손으로 거두어라"
	return ""

# ── 단계 전진 ──────────────────────────────────────────────────────────────
# 각 사건은 "지금 그 단계일 때만" 다음으로 넘긴다(순서·멱등 안전). 잘못된 단계에서
# 들어온 호출은 조용히 무시된다 — 다른 칸을 먼저 갈거나 같은 동작을 반복해도 안전.
func _advance_from(expected: int) -> void:
	if step == expected:
		step += 1
		changed.emit(step)

func notice_seen() -> void:    # 옥자 통보 대화를 끝까지 봤다
	_advance_from(NOTICE)

func talked_to_miho() -> void: # 미호에게 말을 걸어 멘토 대화를 끝냈다
	_advance_from(MEET_MIHO)

func tilled() -> void:         # 흙을 갈았다(괭이질)
	_advance_from(TILL)

func planted() -> void:        # 씨앗을 심었다
	_advance_from(PLANT)

func watered() -> void:        # 물을 줬다
	_advance_from(WATER)

func crop_ready() -> void:     # 물 준 작물이 다 자라 수확 가능해졌다(취침으로 하루 경과)
	_advance_from(GROW)

func harvested() -> void:      # 첫 수확을 했다 → 온보딩 완료(DONE)
	_advance_from(HARVEST)

# ── T2.5 세이브/로드 ──────────────────────────────────────────────────────
# 단계 하나만 직렬화한다. 복원 시 [NOTICE, DONE]로 잘라 손상 세이브에 방어한다.
func to_save() -> Dictionary:
	return {"step": step}

func load_save(data: Dictionary) -> void:
	step = clampi(int(data.get("step", NOTICE)), NOTICE, DONE)
	changed.emit(step)
