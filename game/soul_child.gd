extends Node2D
class_name SoulChild
# ★[S10-T4 / ADR-0069 결정 12] 동행 혼 — 혼례 결속에서 안식 농원에 깃든 작은 새 혼.
#
# 목적: CONTEXT [동행 혼]과 [ADR-0032] 결정 4가 예약해 둔 자리를 **최소 구현**으로 세운다.
#       혼례 후 14일 아침의 탄생(1회성) · 최대 1 · 집 상주 · 상호작용 1종 · 이혼해도 잔류.
#
# ── 어길 수 없는 설정선(CONTEXT [동행 혼]) ──────────────────────────────────
#   · ⚠️ **생물학적 출산이 아니다.** 죽은 영혼이 아기를 낳지 않는다 — [그날 밤]의 모찌·네오
#     "탄생"·프로스티 "형상화"와 같은 *혼의 형상화* 법칙의 가정판이다. 그래서 아래 본문은
#     한 줄도 임신·출산·핏줄을 말하지 않고, **깃들었다**는 말만 쓴다.
#   · 결속에서 깃들므로 **성별·생물학 무관**이다(동성 부부 포함 전 부부 동일 — 입양 분기 0).
#     본문에 성별을 가리키는 말이 없는 것은 실수가 아니라 설정이다.
#   · 속죄 테마의 대구: *파괴*(그 밤의 불)에서 났던 모찌·네오의 반대편 — 이번엔 *사랑의
#     결속*에서 깃든다("파괴→양육"의 가족판, ADR-0004).
#
# ── ⚠️ 봉인 법칙([ADR-0016]) ────────────────────────────────────────────────
#   이 존재는 **그날 밤을 모른다.** 대화재도, 옥자도, 중심 진실도 한 글자도 말하지 않는다 —
#   B7 *이후*의 층이라 서사 충돌이 없다는 것(결정 12)은 "여기서 척추를 이어도 된다"는 뜻이
#   아니라 "척추를 안 건드려도 성립한다"는 뜻이다. 본문은 오늘의 집·오늘의 볕만 말한다.
#
# 설계 메모(kitchen_youkai.gd 동형 — 조연 등재의 확립 관례):
#   - 자기 몸을 _draw로 그리고 대사는 자기가 든다. 위치·스케줄·가시성 게이트는 한 줄도 여기
#     없다(전부 main `_setup_residents()`의 레코드 소관 — ADR-0060 결정 7).
#   - `plain_talk = true` 경로라 대사 시그니처가 `lines_resident()`다(하트·first_today 인자 없음).
#     **관계 트랙 0**이므로 선물도 하트도 생일도 없다 — 상호작용은 인사 한 종뿐(결정 12 자구).
#   - **탄생 컷신 데이터도 이 파일이 든다**([ADR-0005] "컷신 데이터 = 캐릭터 파일 소유"). 러너는
#     스텝 배열을 받아 재생할 뿐 어떤 장면도 모른다(cutscene.gd 머리말).
#   - **초상화 없음**(portrait_stem="") — 트랙 0이라 초상 칸을 열면 "깊이가 있는 사람"이라는
#     잘못된 약속이 된다(주방요괴·무골과 같은 판단).

# ── 탄생 컷신(1회성 — [ADR-0068] 결정 9 이전의 4동사만 쓴다) ─────────────────
# 연출 등급 2(인게임 스크립트 이벤트). NPC 이동도 카메라 팬도 없다 — **암전 뒤에서 일어나는
# 일**이라 화면에 옮길 것이 없기 때문이다(컷신 NPC 이동은 암전 뒤에서만이라는 규약의 극단값).
# 시계를 세우는 것은 "이 아침만은 하루가 시작되기 전에 멈춘다"는 뜻이다.
const BIRTH_CUTSCENE := [
	{"verb": "clock", "running": false},
	{"verb": "fade", "to": 1.0, "secs": 0.7},
	{"verb": "fade", "to": 1.0, "secs": 1.0},   # 암전 유지 — 형상화가 일어나는 시간
	{"verb": "fade", "to": 0.0, "secs": 0.9},
]

# 탄생 직후의 지문(화자 없음 = 내면). ★ 화자를 두지 않는 이유: 이 순간을 말해 줄 사람이 방에
# 없다. 부부 둘 다 잠에서 깬 참이고, 깃든 쪽은 아직 말을 모른다.
const BIRTH_LINES := [
	"눈을 뜨자, 방 안의 공기가 한 뼘쯤 따뜻해져 있었다.",
	"부적에 엮인 두 혼(魂) 사이에서 — 아주 작은 세 번째가, 조용히 형상을 얻었다.",
	"낳은 것이 아니다. 불러들인 것도 아니다. 그저, 곁에 있기로 한 것이다.",
	"[smile]작은 혼이 이불깃을 붙잡고 이쪽을 본다. 오늘부터 집에 셋이 산다.",
]

# 일상 대사 — 하트 단계가 없으므로 **한 묶음**이다(주방요괴 lines_resident와 같은 결).
# 말을 다 배우지 못한 결이라 문장이 짧고, 화제는 집 안을 넘지 않는다(봉인 법칙).
const LINES := [
	"[talk]…아. 왔다.",
	"[smile]여기 볕 따뜻해. 여기 있을래.",
	"[talk]밖에 나갔다 오면, 냄새가 달라. 흙이랑, 물이랑, 먼 데.",
]

func display_name() -> String:
	return "동행 혼"

func lines_resident() -> PackedStringArray:
	return PackedStringArray(LINES)

func birth_lines() -> PackedStringArray:
	return PackedStringArray(BIRTH_LINES)

# P2.3② 도색 스프라이트(있으면 그레이박스 대신). 시트가 도착하는 날 이 파일은 0줄 바뀐다
# (아트 패스 T9 소관 — 연출·스프라이트는 아트 1종, 결정 12 마지막 줄).
var _sprite: AnimatedSprite2D = null

func _ready() -> void:
	_sprite = CharSprite.make("res://assets/characters/soul_child.png")
	if _sprite != null:
		add_child(_sprite)

# ★[S2-T7] 보간 걷기 시각 오프셋(ResidentWalk가 채운다). 주민 프레임워크 공통 규약이라 새
# 캐릭터 파일도 이 블록을 그대로 복사한다. 동행 혼은 자리가 하나뿐이라 실제로는 안 걷는다.
var walk_offset := Vector2.ZERO

func set_walk_offset(v: Vector2) -> void:
	if walk_offset == v:
		return
	walk_offset = v
	if _sprite != null:
		_sprite.position = v
	queue_redraw()

# 그레이박스 몸 — 발치 원점(y=0) 기준 위로 세운다(캐릭터 공통 접지선 규약).
# 실루엣 = **사람 형태의 절반 키에 윤곽이 번지는 작은 덩이**. 성별·종족을 특정하는 형태(머리
# 모양·옷·귀)는 안 그린다 — 형상을 아직 다 얻지 못한 혼이라는 것이 이 실루엣의 전부다.
const _BODY := Vector2(12.0, 16.0)            # 사람형 16×32의 절반 키(한눈에 "작다"가 읽히게)
const _COL_BODY := Color(0.72, 0.78, 0.86, 0.92)   # 옅은 혼백빛(반투명 — 아직 덜 여문 형상)
const _COL_GLOW := Color(0.80, 0.86, 0.94, 0.30)   # 둘레에 번지는 훈(暈)
const _COL_EYE := Color(0.36, 0.40, 0.48)          # 눈 한 쌍(저승 결 — 신호는 여기까지만)

func _draw() -> void:
	draw_set_transform(walk_offset)
	if _sprite != null:
		return  # 도색 스프라이트가 있으면 그레이박스는 안 그린다(폴백 전용)
	var half := _BODY.x * 0.5
	# 훈 — 몸통보다 한 겹 크게 깔아 윤곽이 번지게(형상이 아직 굳지 않았다는 유일한 시각 신호).
	draw_rect(Rect2(-half - 2.0, -_BODY.y - 2.0, _BODY.x + 4.0, _BODY.y + 3.0), _COL_GLOW)
	# 몸통.
	draw_rect(Rect2(-half, -_BODY.y, _BODY.x, _BODY.y), _COL_BODY)
	# 눈 한 쌍.
	draw_rect(Rect2(-4.0, -_BODY.y + 4.0, 2.0, 2.0), _COL_EYE)
	draw_rect(Rect2(2.0, -_BODY.y + 4.0, 2.0, 2.0), _COL_EYE)
