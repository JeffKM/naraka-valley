# 스테이션 칸으로 즉시 스냅하고(말 걸기 판정·헤드리스 테스트가 보는 값 불변), *그림만* 이만큼 뒤로
# 밀어 길 스포크를 따라 걸어온 것처럼 보이게 한다. 주민 프레임워크 공통 규약이라 새 주민 캐릭터
# 파일도 이 블록을 그대로 복사한다(miho.gd·gangrim.gd 동형).
var walk_offset := Vector2.ZERO

func set_walk_offset(v: Vector2) -> void:
	if walk_offset == v:
		return
	walk_offset = v
	if _sprite != null:
		_sprite.position = v   # 도색 스프라이트는 자식 노드 → 자식 위치로 민다
	queue_redraw()             # 그레이박스는 _draw의 draw_set_transform으로 민다

# 실루엣 설계([narrative-bible §5.3] "인어 · 노래 · 평생 누워만 있던 몸"):
#   ㉠ **발이 없다** — 로스터에서 유일하다. 하반신이 옆으로 퍼진 **꼬리지느러미**라 실루엣
#      **밑동이 가로로 넓고 상체는 좁다**(사람형 16폭의 몸통이 아래에서 갑자기 벌어진다).
#      프로스티(전체가 큼)·모찌(전체가 납작)와 달리 *아래만* 넓은 유일한 형태고, 멀리서도
#      "저것은 서 있는 게 아니라 앉아 있다"로 읽힌다.
#   ㉡ **키가 낮다** — 앉은 자세라 전체 높이가 몸 규격의 3분의 2쯤에서 끝난다(BODY_SIZE는
#      자리 규격이지 그림 높이가 아니다). 이 낮음이 "누워 있던 존재"의 첫 신호다.
#   ㉢ **긴 머리 한 덩이** — 어깨 아래까지 흐르는 청록. 설화(백발 두 갈래)·스칼렛(뱀 세 가닥)과
#      갈리게 **가르지 않고 한 덩이로** 흘린다(물에 잠겨 퍼진 결).
#   ㉣ **두 색** — 하반신 비늘은 짙은 청록, 상반신은 창백한 물빛. 강림(무채색 최하단)의 반대편
#      이고 설화(남빛)보다 초록이 세다.
#   ㉤ **입을 그린다** — 노래하는 자다. 강림(입 없음 = 안 여는 자)·프로스티(말 못 함)와 정확히
#      대비되는 자리라, 이 한 획이 로스터 안에서 세 인물을 한 축에 세운다.
const _TAIL_W := 24.0      # 꼬리지느러미 폭(몸통 16보다 넓다 — 실루엣의 정체성)
const _SIT_H := 21.0       # 앉은 전체 높이(32의 3분의 2쯤 — 낮음이 곧 자세다)

func _draw() -> void:
	draw_set_transform(walk_offset)   # ★ [S2-T7] 보간 걷기: 그레이박스 그림 전체를 오프셋만큼 민다
	if _sprite != null:
		return  # 도색 스프라이트가 있으면 그레이박스는 안 그린다(폴백 전용)
	var top := -_SIT_H
	# 꼬리지느러미(㉠) — 발치 원점 선에 옆으로 퍼진 짙은 청록. 밑동이 가장 넓다.
	draw_rect(Rect2(-_TAIL_W * 0.5, -3.0, _TAIL_W, 3.0), Color(0.16, 0.44, 0.46))
	# 꼬리 몸통 — 아래로 갈수록 벌어지는 두 단(폴리곤 없이 사각 두 장으로 실루엣만 만든다).
	draw_rect(Rect2(-7.0, -9.0, 14.0, 6.0), Color(0.19, 0.52, 0.52))
	draw_rect(Rect2(-5.0, top + 7.0, 10.0, 5.0), Color(0.22, 0.58, 0.56))
	# 상반신(㉣) — 창백한 물빛. 꼬리보다 좁아 위로 갈수록 가늘어진다.
	draw_rect(Rect2(-4.0, top + 4.0, 8.0, 8.0), Color(0.76, 0.84, 0.86))
	# NW 광원(asset-ruleset §NW): 왼쪽 결에 밝은 띠 한 줄.
	draw_rect(Rect2(-4.0, top + 4.0, 2.0, 8.0), Color(0.88, 0.94, 0.95))
	# 머리 — 작고 갸름하다(켄의 각진 큰 머리와 반대편).
	var head_c := Vector2(0.0, top + 2.0)
	draw_circle(head_c, 4.2, Color(0.80, 0.87, 0.88))
	# 긴 머리 한 덩이(㉢) — 머리 뒤에서 어깨 아래까지 한 번에 흘린다(가르지 않는다).
	draw_rect(Rect2(-5.5, top - 1.0, 11.0, 4.0), Color(0.18, 0.50, 0.50))
	draw_rect(Rect2(-5.5, top + 3.0, 2.5, 9.0), Color(0.18, 0.50, 0.50))
	draw_rect(Rect2(3.0, top + 3.0, 2.5, 9.0), Color(0.18, 0.50, 0.50))
	# 눈 둘 — 물빛 짙은 청록(채도가 있는 유일한 눈. 강림의 무채색 회백과 반대편).
	draw_rect(Rect2(head_c + Vector2(-2.8, -0.8), Vector2(1.8, 1.2)), Color(0.10, 0.32, 0.34))
	draw_rect(Rect2(head_c + Vector2(1.0, -0.8), Vector2(1.8, 1.2)), Color(0.10, 0.32, 0.34))
	# 입(㉤) — 노래하는 자라 작게 열려 있다. 로스터에서 이 한 획이 정체성이다.
	draw_rect(Rect2(head_c + Vector2(-0.8, 1.6), Vector2(1.8, 1.4)), Color(0.42, 0.28, 0.34))
