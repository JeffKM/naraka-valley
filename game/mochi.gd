# cutscene.gd 포맷 그대로다. **다섯 번째 동사는 없다**(npc/cam/fade/clock).
#
# ★ **npc 동사를 쓰지 않는다**(미호와 다른 선택 — 의도적이다). 미호는 스테이션이 사실상 밭
#   한 곳이라 컷신 좌표를 밭 좌표계로 못박을 수 있지만, 모찌는 하루에 **세 구역-자리**(집 앞 →
#   광장 → 카페)를 돈다. 훅에는 구역 인자가 없으므로 어느 좌표를 적어도 나머지 두 자리에서
#   관문이 열리면 그림이 순간 이동한다. 그래서 이 컷신은 **암전과 카메라만으로 호흡을 만든다** —
#   NPC를 안 움직이면 "암전 뒤에서만 움직인다" 규약을 위반할 여지 자체가 없다(구역 인지 훅은
#   owner 큐 — S9b 연출 작업에서 재평가). 미호 CUTSCENE_HEART_2가 같은 형태의 선례다.
# ★ 길이는 짧게(≈2.2초). 비트 본체는 발화고 컷신은 그 앞의 숨 고르기다.
const CUTSCENE_HEART_3 := [
	{"verb": "clock", "running": false},
	{"verb": "cam", "offset": Vector2(0, -10), "secs": 0.5},   # 눈높이가 낮은 존재 쪽으로 내려간다
	{"verb": "fade", "to": 0.45, "secs": 0.5},                 # 안쪽 맛 이야기가 시작되는 그늘
	{"verb": "fade", "to": 0.0, "secs": 0.5},
	{"verb": "cam", "offset": Vector2(0, 0), "secs": 0.4},
	{"verb": "clock", "running": true},
]

