# ★[S9-T9] 생일 — 피안절 19일(Resident.BIRTHDAYS "neo": [0, 19] — "멈췄던 것이 다시 감기는 절기").
# ★ 네오에게 생일은 *제작일*이 아니라 **기동 로그의 타임스탬프**다. 그 건조함 자체가 축하를
#   받는 순간 흔들리는 것이 이 네 줄의 설계다(자기 정의를 남이 갱신해 준다).
const BIRTHDAY := [
	"[talk]기동 기념일이다. 기록상 오늘이다. 축하할 항목은 아니다.",
	"[shy]…자네가 그것을 조회했다는 사실은 별개로 기록해 두겠다.",
	"[talk]선물은 불필요하다. 재고는 충분하다. 나는 먹지도 않는다.",
	"[smile]…그런데 왜 매대를 두 번 정리했는지는 나도 설명하지 못하겠다.",
]

# 대화창에 띄울 이름.
func display_name() -> String:
	return "네오"

# 말 걸었을 때 들려줄 대사 줄들. hearts = 현재 하트 단계, first_today = 오늘 첫 대화인가
# (mel.gd와 같은 시그니처). 오늘 두 번째 이후면 짧은 인사 한 줄(일일 보상은 Affinity가 막음).
# ★[S9-T9 / ADR-0067 결정 5] **4단**으로 재배치됐다: ♡0 낯섦 / ♡1+ 단골 / ♡3+ 친근 / ♡5 깊은
#   단골. 옛 분기(0/2/4)와 문턱이 다른 것은 의도다 — 관문 이벤트가 칸마다 하나씩 서는 지금,
#   묶음 경계가 관문 경계(♡1·♡3·♡5)와 어긋나면 "진급했는데 대사가 그대로"가 생긴다.
# ★ 어느 단계도 메인 서사 조각(옥자 봉인 죄목 등)은 건드리지 않는다 — 점주 플레이버 + 네오
#   본성 축(감정 '오류')까지다.
func lines(hearts: int = 0, first_today: bool = true) -> PackedStringArray:
	if not first_today:
		return PackedStringArray([LINE_AGAIN_BOND if hearts >= 5 else LINE_AGAIN])
	if hearts >= 5:
		return PackedStringArray(LINES_BOND)
	if hearts >= 3:
		return PackedStringArray(LINES_CLOSE)
	if hearts >= 1:
		return PackedStringArray(LINES_WARMING)
	return PackedStringArray(LINES_INTRO)

# ★[S9-T9] 단계 관문 발화 — **♡3 한 칸만** 본문을 가진다(나머지는 빈 배열 = placeholder 폴백).
func heart_gate_lines(target: int) -> PackedStringArray:
	if target == 3:
		return PackedStringArray(GATE_HEART_3)
	return PackedStringArray()

# ★[S9-T9] 관문 컷신 — ♡3 비트에만 선다. 빈 배열 = 컷신 없이 대화만(하위호환 경로 그대로).
func heart_gate_cutscene(target: int) -> Array:
	if target == 3:
		return CUTSCENE_HEART_3.duplicate(true)
	return []

# ★[S9-T9] 절기 물음(season = GameClock의 절기 인덱스 0..3). 빈 dict = 이 절기엔 물음 없음.
# 반환 dict는 **읽기 전용으로 다뤄라** — 원본 const를 넘기지 않고 얕은 사본을 준다.
func season_question(season: int) -> Dictionary:
	if season < 0 or season >= SEASON_QUESTIONS.size():
		return {}
	var q: Dictionary = SEASON_QUESTIONS[season]
	return {
		"line": String(q.get("line", "")),
		"options": PackedStringArray(q.get("options", [])),
		"replies": PackedStringArray(q.get("replies", [])),
	}

# ★[S9-T9] 생일 당일 플레이버(평소 묶음 앞에 선다).
func birthday_lines() -> PackedStringArray:
	return PackedStringArray(BIRTHDAY)

# P2.3② P2.1 도색 스프라이트(있으면 그레이박스 대신). 상주 NPC라 남쪽(down) 첫 프레임 정지.
var _sprite: AnimatedSprite2D = null

func _ready() -> void:
	_sprite = CharSprite.make("res://assets/characters/neo.png")
	if _sprite != null:
		add_child(_sprite)

# ★ [S2-T7] 보간 걷기 시각 오프셋(ResidentWalk가 채운다 — resident_walk.gd). 논리 위치(position)는
# 스테이션 칸으로 즉시 스냅하고(말 걸기 판정·헤드리스 테스트가 보는 값 불변), *그림만* 이만큼 뒤로
# 밀어 길 스포크를 따라 걸어온 것처럼 보이게 한다. 도착하면 0으로 수렴한다.
# 주민 프레임워크 공통 규약이라 새 주민 캐릭터 파일도 이 블록을 그대로 복사한다(miho.gd 동형).
var walk_offset := Vector2.ZERO

func set_walk_offset(v: Vector2) -> void:
	if walk_offset == v:
		return
	walk_offset = v
	if _sprite != null:
		_sprite.position = v   # 도색 스프라이트는 자식 노드 → 자식 위치로 민다
	queue_redraw()             # 그레이박스는 _draw의 draw_set_transform으로 민다

func _draw() -> void:
	draw_set_transform(walk_offset)   # ★ [S2-T7] 보간 걷기: 그레이박스 그림 전체를 오프셋만큼 민다
	if _sprite != null:
		return  # 도색 스프라이트가 있으면 그레이박스는 안 그린다(폴백 전용)
	# 몸체: 발치 원점 기준 위로 16×32. 백자 오프화이트(차가운 로봇 형태)로 멜·미호·옥자와 구분.
	var body := Rect2(-BODY_SIZE.x * 0.5, -BODY_SIZE.y, BODY_SIZE.x, BODY_SIZE.y)
	draw_rect(body, Color(0.86, 0.84, 0.80))
	# 얼굴(더 밝은 백자) — 머리 면
	var top := -BODY_SIZE.y
	draw_rect(Rect2(body.position + Vector2(0, 4), Vector2(BODY_SIZE.x, 8)), Color(0.93, 0.92, 0.90))
	# 이모티콘 눈빛: 얼굴에 작은 어두운 점 둘(감정을 흉내 내는 로봇 — CONTEXT '이모티콘 눈빛')
	draw_rect(Rect2(-4, top + 7, 2, 2), Color(0.18, 0.20, 0.26))
	draw_rect(Rect2(2, top + 7, 2, 2), Color(0.18, 0.20, 0.26))
	# 머리 위 태엽 키: 짧은 세로 줄기 + 가로 챙(멜의 평평한 관모·옥자 뾰족모자·도깨비 외뿔과 구분되는
	# 태엽 모티프 — CONTEXT '태엽 인형'). 가로 챙 위 세로 줄기로 'ㅜ' 뒤집은 키 형태를 암시.
	draw_rect(Rect2(-3, top - 2, 6, 2), Color(0.45, 0.46, 0.50))   # 키 가로 챙
	draw_rect(Rect2(-1, top - 5, 2, 3), Color(0.45, 0.46, 0.50))   # 키 세로 줄기
	# 관절 이음새 암시: 몸통 가운데 가로 한 줄(백자 관절 — 차가운 기계 형태)
	draw_rect(Rect2(body.position.x, top + 18, BODY_SIZE.x, 1), Color(0.70, 0.68, 0.64))
