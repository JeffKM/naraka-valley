	for r in _residents:
		if r.affinity != null and r.save_key != "":
			data[r.save_key] = r.affinity.to_save()
	# ★ 활성 슬롯에 저장 + 코지 다이어리 메타(날짜·혼력) 헤더를 얹는다(타이틀 슬롯 UI가
