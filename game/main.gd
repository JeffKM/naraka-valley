	_setup_frame()          # ★ C2 공통 인벤토리 프레임(메뉴/출하함/매대/상자)
	_setup_settings()       # ★ Phase D 설정(볼륨·전체화면 — audio·프레임 존재 후, 프레임 신호 연결·적용)
	_skin_panel_text()      # ★ Phase B 한지 테마(밝은 배경) 위 라벨을 먹빛으로(대비 확보)
	_setup_clock()
