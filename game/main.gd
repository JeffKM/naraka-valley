	quest_board.name = "QuestBoard"
	add_child(quest_board)
	quest_board.changed.connect(queue_redraw)   # 수락·납품·만료·복원 시 게시판 그레이박스 갱신
	forage = Forage.new()                # ★ [B1-a.3] 사료풀 상태 노드(코드 생성 — 낫 채집·재생 원장, 여물광 건초 소스)
