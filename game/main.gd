	CLIFF_FACE, CLIFF_LIP, CLIFF_FACE_BASE, CLIFF_BANK,
	BARN_FLOOR, BARN_WALL, COOP_FLOOR, COOP_WALL, STOREHOUSE_FLOOR, STOREHOUSE_WALL,
